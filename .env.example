# AI Data Analyst — Environment Configuration Template
# =====================================================
# Bu dosyayı kopyalayın:
#   cp .env.example .env
# ve kendi değerlerinizle doldurun.
# .env dosyası .gitignore tarafından görmezden gelinir — asla commit etmeyin!

# ── LLM Bağlantı Ayarları ─────────────────────────────────────────────────────

# LLM sunucusunun base URL'i (LM Studio, Ollama, OpenAI, vs.)
# Örnekler:
#   LM Studio (yerel):   http://127.0.0.1:1234/v1
#   Ollama (yerel):      http://localhost:11434/v1
#   OpenAI:              https://api.openai.com/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1

# Kullanılacak model adı
# LM Studio'da yüklü modelin adını kullanın (örn: mistral-7b-instruct)
# OpenAI için: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
LLM_MODEL=mistral-7b-instruct

# API Anahtarı
# LM Studio veya Ollama için herhangi bir değer olabilir (doğrulama yapmaz)
# OpenAI için gerçek API anahtarınızı kullanın: sk-...
LLM_API_KEY=lm-studio

# ── LLM Parametre Ayarları ─────────────────────────────────────────────────────

# Maksimum üretilecek token sayısı (öneri: 4096-8192)
LLM_MAX_TOKENS=4096

# Yaratıcılık seviyesi (0.0=belirleyici, 1.0=yaratıcı)
# Veri analizi için düşük değerler önerilir (0.1-0.3)
LLM_TEMPERATURE=0.1
